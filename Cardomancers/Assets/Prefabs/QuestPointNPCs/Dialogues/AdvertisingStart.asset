  lines:
  - talksprite: {fileID: 21300000, guid: 2b3995ba25f61de4a96779dbeaa5d451, type: 3}
    displayName: Mallory
    textDelay: 0
    text: ' Are you excited to get your first job?'
  - talksprite: {fileID: 1131555762, guid: b64c34112d8176541b6e3fa53969d57e, type: 3}
    displayName: Hackwiz
    textDelay: 0
    text: "\U0001F635\U0001F480\U0001F54A\uFE0F"
  - talksprite: {fileID: 21300000, guid: 2b3995ba25f61de4a96779dbeaa5d451, type: 3}
    displayName: Mallory
    textDelay: 0
    text: "Haha! I was exactly the same when I was your age. Don\u2019t worry, we\u2019ll
      start you out with something easy: putting up posters advertising our shop."
  - talksprite: {fileID: 21300000, guid: 2b3995ba25f61de4a96779dbeaa5d451, type: 3}
    displayName: Mallory
    textDelay: 0
    text: And do try to make it back before dark!
  - talksprite: {fileID: 1131555762, guid: b64c34112d8176541b6e3fa53969d57e, type: 3}
    displayName: Hackwiz
    textDelay: 0
    text: "\U0001F644\U0001F44D\r\n"
