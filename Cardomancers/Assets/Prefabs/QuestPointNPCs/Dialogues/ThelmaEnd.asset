  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2d6a7fd86913b514e82373a096f27bd2, type: 3}
  m_Name: ThelmaEnd
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScripts.DialogueSO
  lines:
  - talksprite: {fileID: 21300000, guid: 2b3995ba25f61de4a96779dbeaa5d451, type: 3}
    displayName: Mallory
    textDelay: 0
    text: Oh thank you dearie, I was so worried about Thelma.
  - talksprite: {fileID: 555138236, guid: e20c3f49b746d944599024516c3cba87, type: 3}
    displayName: ???
    textDelay: 0
    text: "You know you can\u2019t compete with us, Mallory. Close your business
      before we do it for you!"
  - talksprite: {fileID: 1131555762, guid: b64c34112d8176541b6e3fa53969d57e, type: 3}
    displayName: Hackwiz
    textDelay: 0
    text: "\U0001F631\U0001F631\U0001F631"
  - talksprite: {fileID: 21300000, guid: 2b3995ba25f61de4a96779dbeaa5d451, type: 3}
    displayName: Mallory
    textDelay: 0
    text: You've got some nerve coming here, Reginald!
  - talksprite: {fileID: -1512011415, guid: e20c3f49b746d944599024516c3cba87, type: 3}
    displayName: Reginald
    textDelay: 0
    text: "I don\u2019t need to answer to the likes of you, The Eve L. Card Company
      is the most powerful conglomerate in the city!"
  - talksprite: {fileID: 555138236, guid: e20c3f49b746d944599024516c3cba87, type: 3}
    displayName: Reginald
    textDelay: 0
    text: "Orders straight from Eve L. See\u2019eeoh: Any and all competition has
      to be destroyed in preperation for the Mega Merger."
  - talksprite: {fileID: 21300000, guid: 2b3995ba25f61de4a96779dbeaa5d451, type: 3}
    displayName: Mallory
    textDelay: 0
    text: "I\u2019ve said it before and I\u2019ll say it again: I\u2019m not closing
      up!"
  - talksprite: {fileID: 1131555762, guid: b64c34112d8176541b6e3fa53969d57e, type: 3}
    displayName: Hackwiz
    textDelay: 0
    text: "\U0001F621\U0001F621\U0001F645\U0001F645"
  - talksprite: {fileID: -1512011415, guid: e20c3f49b746d944599024516c3cba87, type: 3}
    displayName: Reginald
    textDelay: 0
    text: "Fine, we\u2019ll do this the hard way. You two, go in there and show them
      why they should\u2019ve listened."
  - talksprite: {fileID: -38017939, guid: 5660cfccf1c410749a95369164e607d3, type: 3}
    displayName: Eve L Minion 1
    textDelay: 0
    text: 'Get ready right now '
  - talksprite: {fileID: -430271553, guid: 5660cfccf1c410749a95369164e607d3, type: 3}
    displayName: Eve L Minion 2
    textDelay: 0
    text: " \u2018Cause we\u2019re gonna make you say ow!"
  - talksprite: {fileID: -430271553, guid: 5660cfccf1c410749a95369164e607d3, type: 3}
    displayName: Eve L Minion 2
    textDelay: 0
    text: ' Why do we have to say this again, this is so stupid'
  - talksprite: {fileID: 21300000, guid: 2b3995ba25f61de4a96779dbeaa5d451, type: 3}
    displayName: Mallory
    textDelay: 0
    text: Shut up! Do you want to get us both fired?
  startsBattle: 1
  hasExclamationMark: 0
  textColorDefault: {r: 1, g: 1, b: 1, a: 1}
