  m_Script: {fileID: 11500000, guid: 2d6a7fd86913b514e82373a096f27bd2, type: 3}
  m_Name: ConeyWarn
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScripts.DialogueSO
  lines:
  - talksprite: {fileID: 1990359765, guid: fac91376465621f47a071d9b4574ee7a, type: 3}
    displayName: Traffic Conius
    textDelay: 0
    text: Hack Wiz! You have to get out of here. Now!
  - talksprite: {fileID: 1131555762, guid: b64c34112d8176541b6e3fa53969d57e, type: 3}
    displayName: Hack Wiz
    textDelay: 0
    text: "\U0001F635\u200D\u2753"
  - talksprite: {fileID: 1990359765, guid: fac91376465621f47a071d9b4574ee7a, type: 3}
    displayName: Traffic Conius
    textDelay: 0
    text: Eve L Mart heard about my plan to take them down. They'll be coming here
      very soon to capture me. If you're here then, they will take you in too.
  - talksprite: {fileID: 1990359765, guid: fac91376465621f47a071d9b4574ee7a, type: 3}
    displayName: Traffic Conius
    textDelay: 0
    text: Don't worry about me. I'll be hiding under this couch. They'll never find
      me there!
  startsBattle: 0
  hasExclamationMark: 0
