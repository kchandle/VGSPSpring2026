  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2d6a7fd86913b514e82373a096f27bd2, type: 3}
  m_Name: GettingHelpStart
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScripts.DialogueSO
  lines:
  - talksprite: {fileID: 21300000, guid: 2b3995ba25f61de4a96779dbeaa5d451, type: 3}
    displayName: Mallory
    textDelay: 0
    text: So Conius got himself arrested? You can stay with me for a while, but we
      will need to get him out of there!
  - talksprite: {fileID: 21300000, guid: 2b3995ba25f61de4a96779dbeaa5d451, type: 3}
    displayName: Mallory
    textDelay: 0
    text: While we're at it, we can also try and get rid of that Eve L Mart.
  - talksprite: {fileID: 21300000, guid: 2b3995ba25f61de4a96779dbeaa5d451, type: 3}
    displayName: Mallory
    textDelay: 0
    text: By we, I mean you and whatever help you can get. My old bones won't let
      me do much.
  - talksprite: {fileID: 21300000, guid: 2b3995ba25f61de4a96779dbeaa5d451, type: 3}
    displayName: Mallory
    textDelay: 0
    text: If you can convince some of those youngsters around town to help out, we'll
      be able to continue.
  startsBattle: 0
  hasExclamationMark: 0
  textColorDefault: {r: 1, g: 1, b: 1, a: 1}
  textBackgroundColorDefault: {r: 1, g: 1, b: 1, a: 1}
  titleBackgroundColorDefault: {r: 1, g: 1, b: 1, a: 1}
