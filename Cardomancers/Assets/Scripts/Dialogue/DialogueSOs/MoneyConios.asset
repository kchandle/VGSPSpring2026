  m_Script: {fileID: 11500000, guid: 2d6a7fd86913b514e82373a096f27bd2, type: 3}
  m_Name: MoneyConios
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScripts.DialogueSO
  lines:
  - talksprite: {fileID: 912327343, guid: fac91376465621f47a071d9b4574ee7a, type: 3}
    displayName: Traffic Conious
    textDelay: 0
    text: I'm so proud of you my boy! Here, have some pocket change
  - talksprite: {fileID: 912327343, guid: fac91376465621f47a071d9b4574ee7a, type: 3}
    displayName: Traffic Conious
    textDelay: 0
    text: ....
  - talksprite: {fileID: 912327343, guid: fac91376465621f47a071d9b4574ee7a, type: 3}
    displayName: Traffic Conious
    textDelay: 0
    text: Ignore that it just fell out of my wallet
  - talksprite: {fileID: 912327343, guid: fac91376465621f47a071d9b4574ee7a, type: 3}
    displayName: Traffic Conious
    textDelay: 0
    text: My back hurts, and I don't wanna pick it up.
  - talksprite: {fileID: -1406194267, guid: fac91376465621f47a071d9b4574ee7a, type: 3}
    displayName: Traffic Conious
    textDelay: 0
    text: Talk to me again when you want to get a j*b.
  startsBattle: 0
