--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2d6a7fd86913b514e82373a096f27bd2, type: 3}
  m_Name: Reginald
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScripts.DialogueSO
  lines:
  - talksprite: {fileID: 0}
    displayName: 'Reginald: '
    textDelay: 0
    text: ' Stop right there, valued customer!

'
  - talksprite: {fileID: 0}
    displayName: 'Hackwiz: '
    textDelay: 0
    text: "\U0001F440...\r\n\r\n"
  - talksprite: {fileID: 0}
    displayName: 'Reginald: '
    textDelay: 0
    text: We've received reports of an uptick of tomfoolerous, cardhacking hooligans!
  - talksprite: {fileID: 0}
    displayName: 'Reginald: '
    textDelay: 0
    text: 'Which is horribly, profit-droppingly ***terrible*** for business...

'
  - talksprite: {fileID: 0}
    displayName: 'Reginald: '
    textDelay: 0
    text: 'It takes away from my **important** managerial time of harassing employees...

'
  - talksprite: {fileID: 0}
    displayName: 'Reginald: '
    textDelay: 0
    text: ': and even worse...

      

'
  - talksprite: {fileID: 0}
    displayName: 'Reginald: '
    textDelay: 0
    text: 'BAD FOR SHAREHOLDER PROFITS!!!

'
  - talksprite: {fileID: 0}
    displayName: 'Reginald: '
    textDelay: 0
    text: You wouldn't get in the way of our wonderful shareholders, would you.
  - talksprite: {fileID: 0}
    displayName: 'Hackwiz: '
    textDelay: 0
    text: " \U0001F914...\r\n"
  - talksprite: {fileID: 0}
    displayName: 'Hackwiz: '
    textDelay: 0
    text: "\u274C\U0001F44E"
  - talksprite: {fileID: 0}
    displayName: 'Hackwiz: '
    textDelay: 0
    text: 'THEN PREPARE TO FEEL THE WRATH OF REGINALD MANAGER!!! '
  startsBattle: 1
