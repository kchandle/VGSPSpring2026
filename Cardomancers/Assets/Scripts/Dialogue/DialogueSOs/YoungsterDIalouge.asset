    text: ' Prepare for trouble!'
  - talksprite: {fileID: -1305924327, guid: 56980f1fbc24f5b4abcd0c44e5ce284e, type: 3}
    displayName: 'Two Head Jock:'
    textDelay: 0
    text: 'We''ll crush you to rubble!

'
  - talksprite: {fileID: -1305924327, guid: 56980f1fbc24f5b4abcd0c44e5ce284e, type: 3}
    displayName: 'Two Head Nerd:'
    textDelay: 0
    text: ' No, you''re SUPPOSED to say "and make it double"! We rehearsed this!'
  - talksprite: {fileID: -1305924327, guid: 56980f1fbc24f5b4abcd0c44e5ce284e, type: 3}
    displayName: 'Two Head Jock:'
    textDelay: 0
    text: Shut up man!
  - talksprite: {fileID: -1305924327, guid: 56980f1fbc24f5b4abcd0c44e5ce284e, type: 3}
    displayName: 'Two Head Nerd:'
    textDelay: 0
    text: No YOU shut up!
  - talksprite: {fileID: -1305924327, guid: 56980f1fbc24f5b4abcd0c44e5ce284e, type: 3}
    displayName: 'Two Head Jock:'
    textDelay: 0
