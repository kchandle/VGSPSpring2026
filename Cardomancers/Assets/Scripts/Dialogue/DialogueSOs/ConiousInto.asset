%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2d6a7fd86913b514e82373a096f27bd2, type: 3}
  m_Name: ConiousInto
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScripts.DialogueSO
  lines:
  - talksprite: {fileID: 0}
    displayName: 'Traffic Conius:'
    textDelay: 0
    text: 'So let me get this straight.

      

      Your plan to get my job
      back is to become the strongest cardomancer in the city, travel to the Capital,
      and *beat up the CEO*.'
  - talksprite: {fileID: 0}
    displayName: wHackwiz
    textDelay: 0
    text: ' ...'
  - talksprite: {fileID: 0}
    displayName: wHackwiz
    textDelay: 0
    text: "\U0001F44D"
  - talksprite: {fileID: 0}
    displayName: 'Traffic Conius:'
    textDelay: 0
    text: ...
  - talksprite: {fileID: 0}
    displayName: 'Traffic Conius:'
    textDelay: 0
    text: 'Well, nothing else has worked so far.

      

      And I do have some
      issues with how the company has been run as of late.

      

      And I
      was fired unfairly... A 7 minute bathroom break is NOT a terminable offense,
      no matter how much they want it to

      

      sigh... I guess it''s alright.

'
  - talksprite: {fileID: 0}
    displayName: wHackwiz
    textDelay: 0
    text: "\U0001F4A5\U0001F4AA\U0001F525\U0001F4AF\r\n"
  - talksprite: {fileID: 0}
    displayName: 'Traffic Conius:'
    textDelay: 0
    text: 'BUT IT AIN''T GONNA BE EASY!!

      

      If you wanna go on a real
      quest, you''re gonna have to be responsible for yourself.

      Starting
      by getting a PROPER deck.

      

'
  - talksprite: {fileID: 0}
    displayName: 'Hackwiz:'
    textDelay: 0
    text: "\U0001F480\r\n"
  - talksprite: {fileID: 0}
    displayName: 'Traffic Conius:'
    textDelay: 0
    text: "Don't look at me like that! Any self respecting wizard needs to start
      with a solid, basic deck. None of that fancy hackery.   \nYou have to learn
      the basics if you really want to become the greatest wizard.  Here's some cards
      to start you off. "
  startsBattle: 0
