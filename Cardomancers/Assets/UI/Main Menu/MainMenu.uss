:root {
}

.unity-button {
}

.unity-button:hover {
    scale: 1.1 1.1;
    transition-duration: 0.1s;
    transition-timing-function: ease-in-circ;
}

.unity-button:active {
    scale: 0.9 0.9 0.9;
    transition-duration: 0.1s;
    transition-timing-function: ease-in-cubic;
}

.background {
    background-image: url("project://database/Assets/UI/Main%20Menu/Game%20Start%20Scene.png?fileID=2800000&guid=221e64509a644694980f926723a13224&type=3#Game Start Scene");
    background-repeat: repeat-x;
}
